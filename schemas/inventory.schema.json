{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inventory.schema.json",
  "title": "AI inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^INV-[0-9]{3,}$"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "ai_system",
              "sdlc_tool",
              "infrastructure",
              "model",
              "dataset",
              "supplier_service"
            ]
          },
          "owner": {
            "type": "string"
          },
          "risk_tier": {
            "type": "string"
          },
          "in_scope": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    }
  }
}
