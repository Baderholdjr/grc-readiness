{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fedramp-reports.schema.json",
  "title": "FedRAMP 20x: Ongoing Certification Report notes (engagement/fedramp/reports.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reports"
  ],
  "properties": {
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "to": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "data_changes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "planned_through": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "planned_changes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recommendations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
