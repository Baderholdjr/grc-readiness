{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engagement.schema.json",
  "title": "Engagement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "framework",
    "client",
    "dates",
    "budget",
    "phases"
  ],
  "properties": {
    "framework": {
      "type": "string"
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "overview": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "subtitle": {
      "type": "string"
    },
    "tldr": {
      "type": "string"
    },
    "ai_usage": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "statement": {
          "type": "string"
        },
        "in_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "in_place": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "foundation",
          "examples"
        ],
        "properties": {
          "foundation": {
            "type": "string"
          },
          "examples": {
            "type": "string"
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hours_total"
      ],
      "properties": {
        "hours_total": {
          "type": "number",
          "minimum": 0
        },
        "hours_used": {
          "type": "number",
          "minimum": 0,
          "default": 0
        },
        "note": {
          "type": "string"
        }
      }
    },
    "dates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "stage1",
        "stage2"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "stage1": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "stage2": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "target_certificate": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "start",
          "end"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "end": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "objective": {
            "type": "string"
          },
          "deliverables": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hours": {
            "type": "number",
            "minimum": 0,
            "description": "Planned hours for this phase (default: the playbook's phase_split of the budget)."
          }
        }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engagement_lead": {
          "type": "string"
        },
        "analysts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "client_sponsor": {
          "type": "string"
        }
      }
    },
    "certification_body": {
      "type": "string"
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "working_rule": {
      "type": "string"
    },
    "guardrails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "key_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_expiry_warning_days": {
      "type": "integer",
      "minimum": 0,
      "default": 30
    },
    "ingest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ai_drafting": {
          "type": "boolean",
          "description": "Allow sending intake documents to the Anthropic API for drafting."
        },
        "model": {
          "type": "string"
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "dir": {
          "type": "string"
        }
      },
      "description": "Use canned test data instead of real Drata/cloud/AI calls (see grc/sandbox.py)."
    },
    "client_view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intro": {
          "type": "string",
          "description": "One line shown under the title of the client view"
        },
        "contact": {
          "type": "string",
          "description": "Who the client's people should contact with questions"
        }
      }
    },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "description": "Client site (grc portal): Cloudflare Worker behind Cloudflare Access. See docs/CLIENT-SITE.md.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Deploy the client site from the portal workflow"
        },
        "worker_name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
          "description": "Cloudflare Worker name (default: grc-portal-<client>)"
        },
        "access_team": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
          "description": "Cloudflare Zero Trust team name: <team>.cloudflareaccess.com"
        },
        "access_aud": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Application Audience (AUD) tag of the Access application"
        },
        "allowed_email_domains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$"
          },
          "description": "Optional second check after Access: only these email domains may use the site"
        },
        "base_branch": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
        },
        "triage_days": {
          "type": "integer",
          "minimum": 1,
          "description": "Warn when a submission waits longer than this (default 5)"
        }
      }
    }
  }
}
