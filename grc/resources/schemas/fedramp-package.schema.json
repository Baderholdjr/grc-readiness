{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fedramp-package.schema.json",
  "title": "FedRAMP 20x: the cloud service offering (engagement/fedramp/package.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "service"
  ],
  "properties": {
    "overview_url": {
      "type": "string",
      "pattern": "^https://\\S+$",
      "description": "Where the Certification Package Overview (JSON) is published; FedRAMP's other reports point to it"
    },
    "fedramp_id": {
      "type": "string",
      "minLength": 1,
      "description": "FedRAMP ID; until one is assigned, the provider's name and the service's acronym"
    },
    "uei": {
      "type": "string",
      "pattern": "^[A-Z0-9]{12}$",
      "description": "SAM.gov Unique Entity Identifier"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "acronym",
        "description",
        "website",
        "logo",
        "types",
        "deployment_model"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "acronym": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "website": {
          "type": "string",
          "pattern": "^https://\\S+$"
        },
        "logo": {
          "type": "string",
          "pattern": "^https://\\S+\\.(png|jpe?g|gif|svg|webp|ico|bmp|tiff?)([?#]\\S*)?$"
        },
        "types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SaaS",
              "PaaS",
              "IaaS"
            ]
          }
        },
        "deployment_model": {
          "enum": [
            "Public Cloud",
            "Government-Only Cloud",
            "Hybrid Cloud",
            "Community Cloud",
            "Government Community Cloud"
          ]
        },
        "business_categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "trust_center": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "description",
        "authentication_required"
      ],
      "properties": {
        "types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://\\S+$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "authentication_required": {
          "type": "boolean"
        },
        "access_instructions": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "secure_configuration_guide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "description",
        "authentication_required"
      ],
      "properties": {
        "types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://\\S+$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "authentication_required": {
          "type": "boolean"
        },
        "access_instructions": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "types",
          "url",
          "description",
          "authentication_required"
        ],
        "properties": {
          "types": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://\\S+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "authentication_required": {
            "type": "boolean"
          },
          "access_instructions": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "pattern": "^(\\+?1[-. ]?)?(\\([0-9]{3}\\)|[0-9]{3})[-. ]?[0-9]{3}[-. ]?[0-9]{4}( ?([xX]|[eE][xX][tT]\\.?|[eE][xX][tT][eE][nN][sS][iI][oO][nN]) ?[0-9]{1,6})?$"
          }
        }
      }
    },
    "assessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "id"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "advisors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "certified_services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "available": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "third_party": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "certified": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fedramp_id",
              "use_case"
            ],
            "properties": {
              "fedramp_id": {
                "type": "string",
                "minLength": 1
              },
              "use_case": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "non_certified": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "provider",
              "use_case"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "website": {
                "type": "string",
                "pattern": "^https://\\S+$"
              },
              "use_case": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "ports_and_protocols": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service",
          "port",
          "protocol",
          "purpose"
        ],
        "properties": {
          "service": {
            "type": "string",
            "minLength": 1
          },
          "port": {
            "type": [
              "string",
              "integer"
            ]
          },
          "protocol": {
            "type": "string",
            "minLength": 1
          },
          "encryption": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "agencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Agencies directly using the offering"
    },
    "sdr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "update_source": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
