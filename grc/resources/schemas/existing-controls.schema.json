{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Client's existing controls (from their control register)",
  "type": "object",
  "required": [
    "controls"
  ],
  "additionalProperties": false,
  "properties": {
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "maps",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "state": {
            "enum": [
              "in_place",
              "partial",
              "planned",
              "not_in_place",
              "not_applicable",
              "unknown"
            ]
          },
          "maps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unrecognized": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "last_tested": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "register": {
            "type": "string"
          },
          "applicable": {
            "type": "string"
          }
        }
      }
    }
  }
}
