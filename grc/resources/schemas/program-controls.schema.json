{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "program-controls.schema.json",
  "title": "Common control catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "controls"
  ],
  "properties": {
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "owner",
          "maps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "frequency": {
            "enum": [
              "continuous",
              "daily",
              "weekly",
              "monthly",
              "quarterly",
              "semiannual",
              "annual",
              "event"
            ]
          },
          "type": {
            "enum": [
              "manual",
              "automated",
              "hybrid"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+:[A-Za-z0-9._-]+$"
            }
          },
          "maps": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[a-z0-9]+$"
            },
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": [
                  "string",
                  "number"
                ]
              }
            }
          },
          "notes": {
            "type": "string"
          },
          "responsibility": {
            "type": "string",
            "description": "Who is responsible for it, in the words questionnaires use, e.g. Service Provider Responsibility, Shared Responsibility (Service Provider and Customer Responsibility), Inherited."
          }
        }
      }
    }
  }
}
